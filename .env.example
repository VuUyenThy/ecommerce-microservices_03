# Sao chép file này thành .env rồi chỉnh sửa. docker-compose có sẵn giá trị mặc định nên KHÔNG bắt buộc phải có .env.
# Các giá trị bên dưới chỉ dành cho môi trường phát triển/học tập, KHÔNG dùng cho production.

# --- PostgreSQL (dùng chung user/password cho 3 container auth-db, customer-db, order-db) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- JWT ---
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=3600



# --- Chính sách giảm giá (GIẢ ĐỊNH, tài liệu thiết kế không quy định): "score:phần_trăm" ---
DISCOUNT_TIERS=0:0,100:5,500:10,1000:15
